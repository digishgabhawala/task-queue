# Local defaults (matching `supabase start`'s well-known local values) are
# already baked into app/config.py -- you only need this file when pointing
# at a REAL Supabase project (deployment) or overriding a local default.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role key from Supabase project settings -- NEVER commit the real value>
# SUPABASE_PUBLISHABLE_KEY=<publishable key from Supabase project settings -- safe for browser use>
# ARTIFACTS_BUCKET=artifacts
# DEFAULT_LEASE_MINUTES=60
# DEFAULT_RETENTION_HOURS=48
# ARTIFACT_RETENTION_HOURS=168

# Human admin authentication. Create the user in Supabase Authentication >
# Users before enabling this. Keep sign-ups disabled in the hosted project.
# AUTH_ENABLED=true
# AUTH_ADMIN_EMAILS=you@example.com
# Machine keys for apps reading admin-only routes (see docs/authentication.md):
# SERVICE_API_KEYS=linkedin-content-agent:<sha256 hex of the app's key>

# Optional identity shown in the hosted worker registry and admin dashboard.
# WORKER_NAME=Digish MacBook
# WORKER_ID=digish-macbook-image-worker

# What this worker runs (required for workers/local_worker.py):
# WORKER_TASK_TYPES=text_generation,image_generation
